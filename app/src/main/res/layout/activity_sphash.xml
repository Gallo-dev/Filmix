<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundApp"
    tools:context=".ui.presentation.splashScreen.ActivitySphash">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:src="@drawable/logo_filmix"
        app:layout_constraintBottom_toTopOf="@id/animacao_tela_splash"
        app:layout_constraintBottom_toBottomOf="@id/animacao_tela_splash"/>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/animacao_tela_splash"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginBottom="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/animation_popcorn"
        />

</androidx.constraintlayout.widget.ConstraintLayout>